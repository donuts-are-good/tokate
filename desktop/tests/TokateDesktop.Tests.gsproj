<Project Sdk="Gsharp.NET.Sdk/0.4.1150">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../*.gs" Exclude="../Program.gs" />
    <PackageReference Include="Goo" Version="0.7.16" />
    <PackageReference Include="Goo.Widgets" Version="0.2.13" />
    <PackageReference Include="Goo.Animations" Version="0.2.5" />
    <GooShaderEffect Include="../Shaders/fresco.slang" TargetPath="Shaders/fresco.goo-effect" />
    <Content Include="../../branding/artwork/backdrop.png;../../branding/artwork/hands-smooth.png;../../branding/artwork/sun.png;../../branding/artwork/moon.png;../../branding/artwork/stone-olive.png;../../branding/fonts/newsreader.ttf;../../branding/fonts/cormorant.ttf;../../branding/fonts/cormorant-italic.ttf" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../branding/artwork/*-daylight.png;../../branding/artwork/*-moonlight.png" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Assets/*.svg" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
