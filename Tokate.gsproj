<Project Sdk="Gsharp.NET.Sdk/0.4.1150">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>tokate</AssemblyName>
    <RootNamespace>Tokate</RootNamespace>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <Version>0.2.70</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.gs" />
    <EmbeddedResource Include="templates/*" />
    <EmbeddedResource Include=".github/workflows/tokate-shared.yml" LogicalName="Tokate.templates.coordinator.yml" />
    <EmbeddedResource Include="site/install.sh" LogicalName="Tokate.templates.install.sh" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
</Project>
